{
    "name": "schachbulle/contao-chesstable-bundle",
    "type": "contao-bundle",
    "description": "Inhaltselement, das aus CSV-Daten mit Semikolon als Trennzeichen eine HTML-Tabelle erzeugt und dabei die Besonderheiten von Schachturniertabellen berücksichtigt.",
    "keywords": [
        "contao",
        "schach",
        "tabelle",
        "csv",
        "turnier"
    ],
    "homepage": "https://github.com/Samson1964/contao-chesstable-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Binding",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "components/flag-icon-css": "^3.5",
        "menatwork/contao-multicolumnwizard-bundle": "^3.6",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoChesstableBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoChesstableBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoChesstableBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-chesstable-bundle/issues",
        "source": "https://github.com/Samson1964/contao-chesstable-bundle"
    }
}
